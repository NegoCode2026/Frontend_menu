# Tavita Frontend — plantilla. Copiar a .env (local) o .env.prod (producción).
# Nunca commitear archivos .env con valores reales (ver .gitignore).

# Ruta de la API desde el navegador (/api = proxy nginx mismo-origen):
API_URL=/api

# URL pública del front (se hornea en el build; sin barra final).
# Local: http://localhost:4200 — Prod: https://menu.tumarca.com
APP_BASE_URL=http://localhost:4200

# Origen del backend (runtime, no se hornea).
# Local (back fuera de Docker): http://host.docker.internal:8080
# Prod (misma red Docker): http://backend:8080
BACKEND_ORIGIN=http://host.docker.internal:8080
